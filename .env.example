DATABASE_URL="postgresql://enlace:enlace_dev@localhost:5433/enlace_dev"
# Restricted, non-superuser role the app/tests actually connect as (docs/06-database-design.md §2).
# DATABASE_URL above is the admin role — used only for running Prisma migrations.
DATABASE_APP_URL="postgresql://enlace_app:enlace_app_dev@localhost:5433/enlace_dev"
BETTER_AUTH_SECRET="dev-only-secret-change-me"
BETTER_AUTH_URL="http://localhost:3001"
